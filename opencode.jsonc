{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",

  "permission": {
    "edit": "allow",

    "bash": {
      "*": "ask",

      "git *": "deny",

      "git status": "allow",
      "git status *": "allow",

      "git diff": "allow",
      "git diff *": "allow",

      "git log": "allow",
      "git log *": "allow",

      "git show": "allow",
      "git show *": "allow"
    },

    "external_directory": "deny"
  }
}