{
  "$schema": "https://opencode.ai/config.json",

  "default_agent": "orchestrator",

  "permission": {
    "edit": "allow",

    "bash": {
      "*": "allow",

      "git push": "deny",
      "git push *": "deny",

      "git reset --hard": "deny",
      "git reset --hard *": "deny"
    },

    "external_directory": "deny"
  }
}